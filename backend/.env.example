# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# --- Supabase PostgreSQL connection ---------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> URI. Use the "Connection pooling" (port 6543) string if you deploy
# somewhere serverless; the direct string (port 5432) is fine locally.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# A plain local PostgreSQL works too. On Windows, write 127.0.0.1 rather
# than localhost: localhost resolves to the IPv6 address ::1 first, and if
# PostgreSQL is only listening on IPv4 (a Docker published port, for
# example) every connection stalls for ~10 seconds before falling back.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/supply_chain_db

# Maximum pooled connections held by the API.
DB_POOL_MAX=5

# --- JWT signing ----------------------------------------------------
# Generate a fresh one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-value
TOKEN_TTL_HOURS=12

# --- CORS -----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
