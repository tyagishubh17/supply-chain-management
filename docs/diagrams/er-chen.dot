graph G {
  layout=neato; splines=true; overlap=false; bgcolor="#f7f4ec"; pad=0.6; outputorder=edgesfirst;
  fontname="DejaVu Sans";
  label=<<FONT POINT-SIZE="22" COLOR="#1d4530"><B>Multi-Vendor Supply Chain Management: ER Diagram (Chen notation)</B></FONT><BR/><FONT POINT-SIZE="14" COLOR="#6d675c">Underlined = primary key, (FK) = foreign key, (UQ) = unique. 1 and N mark the cardinality of each relationship.</FONT>>; labelloc=t;
  node [fontname="DejaVu Sans", fontsize=13, style=filled];
  edge [color="#1d4530", penwidth=1.5, fontname="DejaVu Sans", fontsize=15, fontcolor="#1d4530"];
  "VENDORS" [shape=box, width=2.3, height=0.9, fillcolor="#2f6b46", fontcolor=white, fontsize=17, penwidth=2.5, color="#1d4530", pos="-8,5.5!", label=<<B>VENDORS</B>>];
  "VENDORS_vendor_id" [shape=ellipse, width=1.75, height=0.62, fillcolor="#e6efe7", color="#cfc7b2", pos="-6.77,8.88!", label=<<U>vendor_id</U>>];
  "VENDORS" -- "VENDORS_vendor_id" [color="#cfc7b2", penwidth=1.2];
  "VENDORS_company_name" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="-10.06,8.45!", label=<company_name>];
  "VENDORS" -- "VENDORS_company_name" [color="#cfc7b2", penwidth=1.2];
  "VENDORS_email" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="-11.60,5.50!", label=<email<BR/><FONT POINT-SIZE="10" COLOR="#5a6672">(UQ)</FONT>>];
  "VENDORS" -- "VENDORS_email" [color="#cfc7b2", penwidth=1.2];
  "VENDORS_password_hash" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="-10.06,2.55!", label=<password_hash>];
  "VENDORS" -- "VENDORS_password_hash" [color="#cfc7b2", penwidth=1.2];
  "VENDORS_created_at" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="-6.77,2.12!", label=<created_at>];
  "VENDORS" -- "VENDORS_created_at" [color="#cfc7b2", penwidth=1.2];
  "PRODUCTS" [shape=box, width=2.3, height=0.9, fillcolor="#2f6b46", fontcolor=white, fontsize=17, penwidth=2.5, color="#1d4530", pos="8,5.5!", label=<<B>PRODUCTS</B>>];
  "PRODUCTS_product_id" [shape=ellipse, width=1.75, height=0.62, fillcolor="#e6efe7", color="#cfc7b2", pos="10.47,1.98!", label=<<U>product_id</U>>];
  "PRODUCTS" -- "PRODUCTS_product_id" [color="#cfc7b2", penwidth=1.2];
  "PRODUCTS_vendor_id" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="12.04,4.03!", label=<vendor_id<BR/><FONT POINT-SIZE="10" COLOR="#a97514">(FK)</FONT>>];
  "PRODUCTS" -- "PRODUCTS_vendor_id" [color="#cfc7b2", penwidth=1.2];
  "PRODUCTS_product_name" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="12.15,6.61!", label=<product_name>];
  "PRODUCTS" -- "PRODUCTS_product_name" [color="#cfc7b2", penwidth=1.2];
  "PRODUCTS_price" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="10.76,8.79!", label=<price>];
  "PRODUCTS" -- "PRODUCTS_price" [color="#cfc7b2", penwidth=1.2];
  "PRODUCTS_quantity" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="8.37,9.78!", label=<quantity>];
  "PRODUCTS" -- "PRODUCTS_quantity" [color="#cfc7b2", penwidth=1.2];
  "PRODUCTS_is_active" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="5.85,9.22!", label=<is_active>];
  "PRODUCTS" -- "PRODUCTS_is_active" [color="#cfc7b2", penwidth=1.2];
  "PRODUCTS_created_at" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="4.10,7.32!", label=<created_at>];
  "PRODUCTS" -- "PRODUCTS_created_at" [color="#cfc7b2", penwidth=1.2];
  "PRODUCTS_updated_at" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="3.77,4.75!", label=<updated_at>];
  "PRODUCTS" -- "PRODUCTS_updated_at" [color="#cfc7b2", penwidth=1.2];
  "CUSTOMERS" [shape=box, width=2.3, height=0.9, fillcolor="#2f6b46", fontcolor=white, fontsize=17, penwidth=2.5, color="#1d4530", pos="-8,-5.5!", label=<<B>CUSTOMERS</B>>];
  "CUSTOMERS_customer_id" [shape=ellipse, width=1.75, height=0.62, fillcolor="#e6efe7", color="#cfc7b2", pos="-6.77,-2.12!", label=<<U>customer_id</U>>];
  "CUSTOMERS" -- "CUSTOMERS_customer_id" [color="#cfc7b2", penwidth=1.2];
  "CUSTOMERS_full_name" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="-10.06,-2.55!", label=<full_name>];
  "CUSTOMERS" -- "CUSTOMERS_full_name" [color="#cfc7b2", penwidth=1.2];
  "CUSTOMERS_email" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="-11.60,-5.50!", label=<email<BR/><FONT POINT-SIZE="10" COLOR="#5a6672">(UQ)</FONT>>];
  "CUSTOMERS" -- "CUSTOMERS_email" [color="#cfc7b2", penwidth=1.2];
  "CUSTOMERS_password_hash" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="-10.06,-8.45!", label=<password_hash>];
  "CUSTOMERS" -- "CUSTOMERS_password_hash" [color="#cfc7b2", penwidth=1.2];
  "CUSTOMERS_created_at" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="-6.77,-8.88!", label=<created_at>];
  "CUSTOMERS" -- "CUSTOMERS_created_at" [color="#cfc7b2", penwidth=1.2];
  "ORDERS" [shape=box, width=2.3, height=0.9, fillcolor="#2f6b46", fontcolor=white, fontsize=17, penwidth=2.5, color="#1d4530", pos="8,-5.5!", label=<<B>ORDERS</B>>];
  "ORDERS_order_id" [shape=ellipse, width=1.75, height=0.62, fillcolor="#e6efe7", color="#cfc7b2", pos="10.49,-0.82!", label=<<U>order_id</U>>];
  "ORDERS" -- "ORDERS_order_id" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_customer_id" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="12.06,-2.09!", label=<customer_id<BR/><FONT POINT-SIZE="10" COLOR="#a97514">(FK)</FONT>>];
  "ORDERS" -- "ORDERS_customer_id" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_product_id" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="13.04,-3.86!", label=<product_id<BR/><FONT POINT-SIZE="10" COLOR="#a97514">(FK)</FONT>>];
  "ORDERS" -- "ORDERS_product_id" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_quantity" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="13.29,-5.87!", label=<quantity>];
  "ORDERS" -- "ORDERS_quantity" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_unit_price" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="12.76,-7.82!", label=<unit_price>];
  "ORDERS" -- "ORDERS_unit_price" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_status" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="11.55,-9.44!", label=<status>];
  "ORDERS" -- "ORDERS_status" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_cancellation_reason" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="9.81,-10.48!", label=<cancellation_reason>];
  "ORDERS" -- "ORDERS_cancellation_reason" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_shipping_address" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="7.82,-10.80!", label=<shipping_address>];
  "ORDERS" -- "ORDERS_shipping_address" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_contact_phone" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="5.84,-10.34!", label=<contact_phone>];
  "ORDERS" -- "ORDERS_contact_phone" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_ordered_at" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="4.19,-9.18!", label=<ordered_at>];
  "ORDERS" -- "ORDERS_ordered_at" [color="#cfc7b2", penwidth=1.2];
  "ORDERS_decided_at" [shape=ellipse, width=1.75, height=0.62, fillcolor="#fffdf8", color="#cfc7b2", pos="3.09,-7.49!", label=<decided_at>];
  "ORDERS" -- "ORDERS_decided_at" [color="#cfc7b2", penwidth=1.2];
  "rel_supplies" [shape=diamond, width=2.1, height=1.2, fillcolor="#fbf1dc", color="#a97514", penwidth=2, pos="0,5.5!", label=<<B>supplies</B>>];
  "VENDORS" -- "rel_supplies" [headlabel="1", labeldistance=3.2, labelangle=0, penwidth=2];
  "rel_supplies" -- "PRODUCTS" [headlabel="N", labeldistance=3.2, labelangle=0, penwidth=2];
  "rel_is ordered in" [shape=diamond, width=2.1, height=1.2, fillcolor="#fbf1dc", color="#a97514", penwidth=2, pos="8,0!", label=<<B>is ordered in</B>>];
  "PRODUCTS" -- "rel_is ordered in" [headlabel="1", labeldistance=3.2, labelangle=0, penwidth=2];
  "rel_is ordered in" -- "ORDERS" [headlabel="N", labeldistance=3.2, labelangle=0, penwidth=2];
  "rel_places" [shape=diamond, width=2.1, height=1.2, fillcolor="#fbf1dc", color="#a97514", penwidth=2, pos="0,-5.5!", label=<<B>places</B>>];
  "CUSTOMERS" -- "rel_places" [headlabel="1", labeldistance=3.2, labelangle=0, penwidth=2];
  "rel_places" -- "ORDERS" [headlabel="N", labeldistance=3.2, labelangle=0, penwidth=2];
}