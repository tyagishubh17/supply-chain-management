digraph ER {
  graph [rankdir=LR, bgcolor="#f7f4ec", pad=0.5, nodesep=0.8, ranksep=2.2, fontname="DejaVu Sans",
         label=<<FONT POINT-SIZE="20" COLOR="#1d4530"><B>Multi-Vendor Supply Chain Management: ER Diagram (crow's foot notation)</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#6d675c">PK primary key, FK foreign key, UQ unique. Every relationship is one to many (one, to zero or many).</FONT>>, labelloc=t];
  node [shape=plaintext, fontname="DejaVu Sans"];
  edge [color="#1d4530", penwidth=1.8, fontname="DejaVu Sans", fontsize=13, fontcolor="#1d4530", dir=both];

  vendors   [label=<<TABLE BORDER="1" COLOR="#cfc7b2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#fffdf8"><TR><TD COLSPAN="3" BGCOLOR="#2f6b46" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="17"><B>VENDORS</B></FONT></TD></TR><TR><TD BGCOLOR="#e6efe7" ALIGN="LEFT" PORT="vendor_id"><FONT COLOR="#23211c" POINT-SIZE="13"><B>vendor_id</B></FONT></TD><TD BGCOLOR="#e6efe7" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">SERIAL</FONT></TD><TD BGCOLOR="#e6efe7" ALIGN="CENTER" PORT="vendor_id_e"><FONT COLOR="#1d4530" POINT-SIZE="12"><B>PK</B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="company_name"><FONT COLOR="#23211c" POINT-SIZE="13">company_name</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">VARCHAR(150)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="company_name_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="email"><FONT COLOR="#23211c" POINT-SIZE="13">email</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">VARCHAR(150)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="email_e"><FONT COLOR="#5a6672" POINT-SIZE="12"><B>UQ</B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="password_hash"><FONT COLOR="#23211c" POINT-SIZE="13">password_hash</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">VARCHAR(255)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="password_hash_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="created_at"><FONT COLOR="#23211c" POINT-SIZE="13">created_at</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">TIMESTAMPTZ</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="created_at_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR></TABLE>>];
  customers [label=<<TABLE BORDER="1" COLOR="#cfc7b2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#fffdf8"><TR><TD COLSPAN="3" BGCOLOR="#2f6b46" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="17"><B>CUSTOMERS</B></FONT></TD></TR><TR><TD BGCOLOR="#e6efe7" ALIGN="LEFT" PORT="customer_id"><FONT COLOR="#23211c" POINT-SIZE="13"><B>customer_id</B></FONT></TD><TD BGCOLOR="#e6efe7" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">SERIAL</FONT></TD><TD BGCOLOR="#e6efe7" ALIGN="CENTER" PORT="customer_id_e"><FONT COLOR="#1d4530" POINT-SIZE="12"><B>PK</B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="full_name"><FONT COLOR="#23211c" POINT-SIZE="13">full_name</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">VARCHAR(150)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="full_name_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="email"><FONT COLOR="#23211c" POINT-SIZE="13">email</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">VARCHAR(150)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="email_e"><FONT COLOR="#5a6672" POINT-SIZE="12"><B>UQ</B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="password_hash"><FONT COLOR="#23211c" POINT-SIZE="13">password_hash</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">VARCHAR(255)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="password_hash_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="created_at"><FONT COLOR="#23211c" POINT-SIZE="13">created_at</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">TIMESTAMPTZ</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="created_at_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR></TABLE>>];
  products  [label=<<TABLE BORDER="1" COLOR="#cfc7b2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#fffdf8"><TR><TD COLSPAN="3" BGCOLOR="#2f6b46" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="17"><B>PRODUCTS</B></FONT></TD></TR><TR><TD BGCOLOR="#e6efe7" ALIGN="LEFT" PORT="product_id"><FONT COLOR="#23211c" POINT-SIZE="13"><B>product_id</B></FONT></TD><TD BGCOLOR="#e6efe7" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">SERIAL</FONT></TD><TD BGCOLOR="#e6efe7" ALIGN="CENTER" PORT="product_id_e"><FONT COLOR="#1d4530" POINT-SIZE="12"><B>PK</B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="vendor_id"><FONT COLOR="#23211c" POINT-SIZE="13">vendor_id</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">INTEGER</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="vendor_id_e"><FONT COLOR="#a97514" POINT-SIZE="12"><B>FK</B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="product_name"><FONT COLOR="#23211c" POINT-SIZE="13">product_name</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">VARCHAR(150)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="product_name_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="price"><FONT COLOR="#23211c" POINT-SIZE="13">price</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">NUMERIC(10,2)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="price_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="quantity"><FONT COLOR="#23211c" POINT-SIZE="13">quantity</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">INTEGER</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="quantity_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="is_active"><FONT COLOR="#23211c" POINT-SIZE="13">is_active</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">BOOLEAN</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="is_active_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="created_at"><FONT COLOR="#23211c" POINT-SIZE="13">created_at</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">TIMESTAMPTZ</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="created_at_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="updated_at"><FONT COLOR="#23211c" POINT-SIZE="13">updated_at</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">TIMESTAMPTZ</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="updated_at_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR></TABLE>>];
  orders    [label=<<TABLE BORDER="1" COLOR="#cfc7b2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#fffdf8"><TR><TD COLSPAN="3" BGCOLOR="#2f6b46" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="17"><B>ORDERS</B></FONT></TD></TR><TR><TD BGCOLOR="#e6efe7" ALIGN="LEFT" PORT="order_id"><FONT COLOR="#23211c" POINT-SIZE="13"><B>order_id</B></FONT></TD><TD BGCOLOR="#e6efe7" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">SERIAL</FONT></TD><TD BGCOLOR="#e6efe7" ALIGN="CENTER" PORT="order_id_e"><FONT COLOR="#1d4530" POINT-SIZE="12"><B>PK</B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="customer_id"><FONT COLOR="#23211c" POINT-SIZE="13">customer_id</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">INTEGER</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="customer_id_e"><FONT COLOR="#a97514" POINT-SIZE="12"><B>FK</B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="product_id"><FONT COLOR="#23211c" POINT-SIZE="13">product_id</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">INTEGER</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="product_id_e"><FONT COLOR="#a97514" POINT-SIZE="12"><B>FK</B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="quantity"><FONT COLOR="#23211c" POINT-SIZE="13">quantity</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">INTEGER</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="quantity_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="unit_price"><FONT COLOR="#23211c" POINT-SIZE="13">unit_price</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">NUMERIC(10,2)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="unit_price_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="status"><FONT COLOR="#23211c" POINT-SIZE="13">status</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">order_status</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="status_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="cancellation_reason"><FONT COLOR="#23211c" POINT-SIZE="13">cancellation_reason</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">TEXT</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="cancellation_reason_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="shipping_address"><FONT COLOR="#23211c" POINT-SIZE="13">shipping_address</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">TEXT</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="shipping_address_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="contact_phone"><FONT COLOR="#23211c" POINT-SIZE="13">contact_phone</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">VARCHAR(25)</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="contact_phone_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="ordered_at"><FONT COLOR="#23211c" POINT-SIZE="13">ordered_at</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">TIMESTAMPTZ</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="ordered_at_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR><TR><TD BGCOLOR="#fffdf8" ALIGN="LEFT" PORT="decided_at"><FONT COLOR="#23211c" POINT-SIZE="13">decided_at</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="LEFT"><FONT COLOR="#6d675c" POINT-SIZE="12">TIMESTAMPTZ</FONT></TD><TD BGCOLOR="#fffdf8" ALIGN="CENTER" PORT="decided_at_e"><FONT COLOR="#6d675c" POINT-SIZE="12"><B> </B></FONT></TD></TR></TABLE>>];

  vendors:vendor_id_e:e -> products:vendor_id:w   [arrowtail=teetee, arrowhead=crowodot, label=" supplies  "];
  products:product_id_e:e -> orders:product_id:w  [arrowtail=teetee, arrowhead=crowodot, label=" is ordered in  "];
  customers:customer_id_e:e -> orders:customer_id:w [arrowtail=teetee, arrowhead=crowodot, label=" places  "];
}